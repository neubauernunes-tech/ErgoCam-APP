{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "profiles": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "plan", "profiles"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User documents containing profiles and plans"
    }
  }
}
